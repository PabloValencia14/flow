<Window x:Class="Flow.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow" Icon="/Flow.Windows;component/FlowLogo.ico" ShowInTaskbar="False" Height="752" Width="1112" MinHeight="632" MinWidth="912"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Outer Container with margin to eliminate shadow clipping -->
    <Border Margin="16"
            Background="{DynamicResource BrushBgMain}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="48" />
                <!-- Main Body -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Chrome Titlebar (Draggable) -->
            <Border Grid.Row="0" Background="{DynamicResource BrushBgSidebar}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Logo & Status Pill -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource BrushBgCardHover}" Margin="0,0,10,0">
                            <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource BrushTextPrimary}"
                                  Data="{StaticResource IconFlowLogo}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Flow" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HubStatusDot" Width="6" Height="6" Fill="{DynamicResource BrushAccentSuccess}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="HubStatusLabel" Text="FlowHub Conectado" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center: Spacer -->
                    <TextBlock Grid.Column="1" Text="" />

                    <!-- Right: Window Buttons & Flow Bar Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Theme Toggle Quick Button -->
                        <Button x:Name="ThemeToggleBtn" Width="32" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ThemeToggleBtn_Click" ToolTip="Cambiar tema (Claro / Oscuro)" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                        <Path x:Name="ThemeIconPath" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.6" Data="{StaticResource IconSun}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBgCardHover}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="ToggleBarBtn" Content="Barra Flotante" Style="{StaticResource WisprGhostButton}"
                                Padding="10,4" Margin="0,0,12,0" FontSize="12" Click="ToggleBarBtn_Click" />

                        <!-- Minimize Button -->
                        <Button Width="32" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" ToolTip="Minimizar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                        <Path Width="10" Height="2" Stretch="Uniform" Fill="{DynamicResource BrushTextSecondary}" Data="{StaticResource IconMinus}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBgCardHover}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close Button -->
                        <Button Width="32" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" ToolTip="Minimizar al fondo (la barra flotante seguirá activa)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.6" Data="{StaticResource IconClose}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBgCardHover}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Body: Left Sidebar + Right Dynamic Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Sidebar -->
                    <ColumnDefinition Width="230" />
                    <!-- Content View -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar (Wispr Flow Hub Layout) -->
                <Border Grid.Column="0" Background="{DynamicResource BrushBgSidebar}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,16">
                    <Grid Margin="12,16,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Navigation Categories -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Category 1: DICTADO & NOTAS -->
                                <TextBlock Text="DICTADO &amp; NOTAS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="10,0,0,8" />

                                <RadioButton x:Name="NavNotes" Style="{StaticResource WisprNavTab}" IsChecked="True" Checked="NavTab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconNotes}" Margin="0,0,10,0" />
                                        <TextBlock Text="Notas &amp; Historial" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavMeetings" Style="{StaticResource WisprNavTab}" Checked="NavTab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconInsights}" Margin="0,0,10,0" />
                                        <TextBlock Text="Reuniones" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavSnippets" Style="{StaticResource WisprNavTab}" Checked="NavTab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconSnippet}" Margin="0,0,10,0" />
                                        <TextBlock Text="Snippets de voz" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Category 2: PERSONALIZACIÓN -->
                                <TextBlock Text="PERSONALIZACIÓN" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="10,18,0,8" />

                                <RadioButton x:Name="NavDictionary" Style="{StaticResource WisprNavTab}" Checked="NavTab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource IconDictionary}" Margin="0,0,10,0" />
                                        <TextBlock Text="Diccionario" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavStyles" Style="{StaticResource WisprNavTab}" Checked="NavTab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Data="{StaticResource IconWand}" Margin="0,0,10,0" />
                                        <TextBlock Text="Estilos &amp; Tonos" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavInsights" Style="{StaticResource WisprNavTab}" Checked="NavTab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Data="{StaticResource IconInsights}" Margin="0,0,10,0" />
                                        <TextBlock Text="Insights &amp; Racha" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Category 3: SISTEMA -->
                                <TextBlock Text="SISTEMA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="10,18,0,8" />

                                <RadioButton x:Name="NavSettings" Style="{StaticResource WisprNavTab}" Checked="NavTab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Data="{StaticResource IconSettings}" Margin="0,0,10,0" />
                                        <TextBlock Text="Configuración" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom User Profile Card -->
                        <Border Grid.Row="1" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BrushWisprGradient}" Margin="0,0,10,0">
                                    <TextBlock Text="PV" Foreground="{DynamicResource BrushOnAccent}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Pablo Valencia" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="pablova04@gmail.com" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Content Views Area -->
                <Grid Grid.Column="1" Background="{DynamicResource BrushBgMain}">

                    <!-- VIEW 1: NOTES & HISTORY -->
                    <Grid x:Name="ViewNotes" Margin="30,22,30,22" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Title & Search -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Notas &amp; Historial" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="Todas las transcripciones y notas de voz capturadas en tus aplicaciones." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Vaciar historial" Style="{StaticResource WisprGhostButton}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Click="ClearHistory_Click" />
                        </Grid>

                        <!-- Filter Pills & Search Box -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Filter Pills -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <RadioButton x:Name="FilterAll" Content="Todos" Style="{StaticResource WisprFilterPill}" IsChecked="True" Checked="Filter_Checked" />
                                <RadioButton x:Name="FilterToday" Content="Hoy" Style="{StaticResource WisprFilterPill}" Checked="Filter_Checked" />
                                <RadioButton x:Name="FilterFavs" Content="Favoritos" Style="{StaticResource WisprFilterPill}" Checked="Filter_Checked" />
                            </StackPanel>

                            <!-- Search Input -->
                            <Grid Grid.Column="1" Margin="14,0,0,0">
                                <TextBox x:Name="NotesSearchBox" Style="{StaticResource WisprTextBox}" TextChanged="NotesSearchBox_TextChanged" />
                                <TextBlock Text="Buscar en notas y dictados…" Foreground="{DynamicResource BrushTextMuted}" FontSize="12.5" IsHitTestVisible="False" Margin="12,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NotesSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- Notes List ScrollViewer -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="NotesContainer">
                                <!-- Cards populated dynamically -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW 2: MEETINGS -->
                    <Grid x:Name="ViewMeetings" Margin="30,22,30,22" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reuniones" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="Importa clases o reuniones y conserva audio, timestamps y transcripción navegable." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ImportMeetingBtn" Content="Importar audio" Style="{StaticResource WisprPrimaryButton}" Padding="14,8" Click="ImportMeetingBtn_Click" />
                                <Button Content="Actualizar" Style="{StaticResource WisprGhostButton}" Margin="8,0,0,0" Padding="14,8" Click="RefreshMeetingsBtn_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="MeetingStatusLabel" Grid.Row="1" Text="" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource WisprCard}" Padding="0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MeetingListContainer" /></ScrollViewer>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource WisprCard}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock x:Name="MeetingTitleLabel" Text="Selecciona una reunión" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                                        <Button x:Name="MeetingPlayBtn" Content="Reproducir audio" Style="{StaticResource WisprGhostButton}" Padding="12,7" Click="MeetingPlayBtn_Click" IsEnabled="False" />
                                        <Button x:Name="MeetingExportMdBtn" Content="Exportar Markdown" Style="{StaticResource WisprGhostButton}" Margin="8,0,0,0" Padding="12,7" Click="MeetingExportMdBtn_Click" IsEnabled="False" />
                                        <Button x:Name="MeetingExportTxtBtn" Content="Exportar .txt" Style="{StaticResource WisprGhostButton}" Margin="8,0,0,0" Padding="12,7" Click="MeetingExportTxtBtn_Click" IsEnabled="False" />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock x:Name="MeetingSummaryLabel" Text="" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                            <TextBlock Text="TRANSCRIPCIÓN" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />
                                            <StackPanel x:Name="MeetingTimelineContainer" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- VIEW 3: SNIPPETS -->
                    <Grid x:Name="ViewSnippets" Margin="30,22,30,22" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Snippets de Voz" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="Crea atajos de voz que se expandan instantáneamente en plantillas o textos largos." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Add Snippet Card Form -->
                        <Border Grid.Row="1" Style="{StaticResource WisprCard}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="FRASE DISPARADORA (TRIGGER)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <TextBox x:Name="SnippetTriggerInput" Style="{StaticResource WisprTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="CATEGORÍA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <TextBox x:Name="SnippetCategoryInput" Text="General" Style="{StaticResource WisprTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                    <TextBlock Text="TEXTO EXPANDIDO (PLANTILLA)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <TextBox x:Name="SnippetExpansionInput" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource WisprTextBox}" />
                                </StackPanel>

                                <Button Grid.Row="2" Grid.ColumnSpan="3" Content="Guardar Snippet" Style="{StaticResource WisprPrimaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="AddSnippetBtn_Click" />
                            </Grid>
                        </Border>

                        <!-- Snippets List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SnippetsContainer">
                                <!-- Cards populated dynamically -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW 3: DICTIONARY -->
                    <Grid x:Name="ViewDictionary" Margin="30,22,30,22" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Diccionario Personal" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="Enseña a Wispr Flow tus nombres propios, acrónimos o términos de tu sector." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Add Word Form -->
                        <Border Grid.Row="1" Style="{StaticResource WisprCard}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PALABRA / TÉRMINO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <TextBox x:Name="NewWordInput" Style="{StaticResource WisprTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="REEMPLAZO (OPCIONAL)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <TextBox x:Name="NewWordRepInput" Style="{StaticResource WisprTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="CATEGORÍA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <TextBox x:Name="NewWordCatInput" Text="Técnico" Style="{StaticResource WisprTextBox}" />
                                </StackPanel>

                                <Button Grid.Column="6" Content="Añadir" Style="{StaticResource WisprPrimaryButton}" VerticalAlignment="Bottom" Click="AddWordBtn_Click" />
                            </Grid>
                        </Border>

                        <!-- Dictionary List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DictionaryContainer">
                                <!-- Populated dynamically -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW 4: STYLES & AI FORMATTING -->
                    <Grid x:Name="ViewStyles" Margin="30,22,30,22" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Estilos &amp; Reglas por Aplicación" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="Elige cómo debe quedar el texto. Flow detecta el destino y aplica el perfil antes de pegarlo." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- App Category 1: Work Messages -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mensajes de Trabajo (Slack &amp; Teams)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Elige si quieres un tono profesional, breve o más cercano sin perder la intención." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Perfil" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                            <ComboBox x:Name="WorkStyleComboBox" SelectedValuePath="Tag" MinHeight="36" Padding="8,5" FontSize="12.5" Background="{DynamicResource BrushBgInput}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" SelectionChanged="StyleSelection_Changed" AutomationProperties.Name="Estilo para mensajes de trabajo">
                                                <ComboBoxItem Content="Automático" Tag="auto" />
                                                <ComboBoxItem Content="Profesional" Tag="professional" />
                                                <ComboBoxItem Content="Conciso" Tag="concise" />
                                                <ComboBoxItem Content="Formal" Tag="formal" />
                                                <ComboBoxItem Content="Cercano" Tag="casual" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- App Category 2: Emails -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Correos Electrónicos (Gmail &amp; Outlook)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Conserva el contenido dictado y mejora la claridad, la cortesía y la estructura del correo." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Perfil" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                            <ComboBox x:Name="EmailStyleComboBox" SelectedValuePath="Tag" MinHeight="36" Padding="8,5" FontSize="12.5" Background="{DynamicResource BrushBgInput}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" SelectionChanged="StyleSelection_Changed" AutomationProperties.Name="Estilo para correos electrónicos">
                                                <ComboBoxItem Content="Automático" Tag="auto" />
                                                <ComboBoxItem Content="Formal" Tag="formal" />
                                                <ComboBoxItem Content="Profesional" Tag="professional" />
                                                <ComboBoxItem Content="Conciso" Tag="concise" />
                                                <ComboBoxItem Content="Cercano" Tag="casual" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- App Category 3: Coding & Prompts -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Código &amp; Prompts de IA (VS Code, Cursor, ChatGPT)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Protege nombres de funciones, comandos, rutas, URLs, cifras y sintaxis para que el modelo no los embellezca." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Perfil" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                            <ComboBox x:Name="CodeStyleComboBox" SelectedValuePath="Tag" MinHeight="36" Padding="8,5" FontSize="12.5" Background="{DynamicResource BrushBgInput}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" SelectionChanged="StyleSelection_Changed" AutomationProperties.Name="Estilo para código y prompts">
                                                <ComboBoxItem Content="Automático" Tag="auto" />
                                                <ComboBoxItem Content="Técnico" Tag="technical" />
                                                <ComboBoxItem Content="Literal" Tag="neutral" />
                                                <ComboBoxItem Content="Conciso" Tag="concise" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- App Category 4: Personal Messages -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mensajes Personales (WhatsApp &amp; Telegram)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Mantén el tono humano y coloquial, eliminando solo errores de reconocimiento y repeticiones accidentales." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Perfil" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                            <ComboBox x:Name="PersonalStyleComboBox" SelectedValuePath="Tag" MinHeight="36" Padding="8,5" FontSize="12.5" Background="{DynamicResource BrushBgInput}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" SelectionChanged="StyleSelection_Changed" AutomationProperties.Name="Estilo para mensajes personales">
                                                <ComboBoxItem Content="Automático" Tag="auto" />
                                                <ComboBoxItem Content="Cercano" Tag="casual" />
                                                <ComboBoxItem Content="Profesional" Tag="professional" />
                                                <ComboBoxItem Content="Conciso" Tag="concise" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW 5: INSIGHTS & STATS -->
                    <Grid x:Name="ViewInsights" Margin="30,22,30,22" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Insights de Dictado" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="Rendimiento de voz, estadísticas de uso y tiempo ahorrado frente al teclado." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- KPI Metric Grid -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- KPI 1 -->
                                    <Border Grid.Column="0" Style="{StaticResource WisprCard}" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="PALABRAS HOY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock x:Name="InsightsWordsToday" Text="269" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- KPI 2 -->
                                    <Border Grid.Column="2" Style="{StaticResource WisprCard}" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="VELOCIDAD MEDIA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock x:Name="InsightsAvgWpm" Text="225 WPM" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushAccentPurple}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- KPI 3 -->
                                    <Border Grid.Column="4" Style="{StaticResource WisprCard}" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="TIEMPO AHORRADO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock x:Name="InsightsTimeSaved" Text="18.5 min" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushAccentSuccess}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- KPI 4 -->
                                    <Border Grid.Column="6" Style="{StaticResource WisprCard}" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="RACHA DIARIA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock x:Name="InsightsStreak" Text="1 día" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushAccentWarning}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Activity Visualizer Card -->
                                <Border Style="{StaticResource WisprCard}">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVIDAD DE LA SEMANA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,14" />
                                        <Grid Height="120">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Mon -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <Border Width="24" Height="20" Background="{DynamicResource BrushBgCardHover}" CornerRadius="4" Margin="0,0,0,6" />
                                                <TextBlock Text="L" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Tue -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <Border Width="24" Height="45" Background="{DynamicResource BrushBgCardHover}" CornerRadius="4" Margin="0,0,0,6" />
                                                <TextBlock Text="M" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Wed (Today) -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <Border Width="24" Height="95" Background="{DynamicResource BrushWisprGradient}" CornerRadius="4" Margin="0,0,0,6" />
                                                <TextBlock Text="X" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentPurple}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Thu -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <Border Width="24" Height="10" Background="{DynamicResource BrushBgCardHover}" CornerRadius="4" Margin="0,0,0,6" />
                                                <TextBlock Text="J" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Fri -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <Border Width="24" Height="10" Background="{DynamicResource BrushBgCardHover}" CornerRadius="4" Margin="0,0,0,6" />
                                                <TextBlock Text="V" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Sat -->
                                            <StackPanel Grid.Column="5" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <Border Width="24" Height="10" Background="{DynamicResource BrushBgCardHover}" CornerRadius="4" Margin="0,0,0,6" />
                                                <TextBlock Text="S" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Sun -->
                                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <Border Width="24" Height="10" Background="{DynamicResource BrushBgCardHover}" CornerRadius="4" Margin="0,0,0,6" />
                                                <TextBlock Text="D" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW 6: SETTINGS -->
                    <Grid x:Name="ViewSettings" Margin="30,22,30,22" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Configuración" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="Micrófonos, efectos de sonido de Wispr Flow, tema visual y conexión FlowHub." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Theme Selection Card -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="TEMA DE LA APLICACIÓN" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeDarkRadio" Content="Modo oscuro" Style="{StaticResource WisprFilterPill}" IsChecked="True" Checked="ThemeRadio_Checked" Margin="0,0,8,0" />
                                            <RadioButton x:Name="ThemeLightRadio" Content="Modo claro" Style="{StaticResource WisprFilterPill}" Checked="ThemeRadio_Checked" Margin="0,0,8,0" />
                                            <RadioButton x:Name="ThemeSystemRadio" Content="Sistema" Style="{StaticResource WisprFilterPill}" Checked="ThemeRadio_Checked" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Audio Input Device -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="ENTRADA DE AUDIO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />
                                        <ComboBox x:Name="MicrophoneComboBox" Background="{DynamicResource BrushBgInput}" Foreground="{DynamicResource BrushTextPrimary}"
                                                  BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="10,8" FontSize="13"
                                                  SelectionChanged="MicrophoneComboBox_SelectionChanged" />
                                    </StackPanel>
                                </Border>

                                <!-- Sound Effects -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Efectos de Sonido de Wispr Flow" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Reproducir sonidos oficiales al iniciar dictado, terminar y pegar texto." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleSounds" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="ToggleSounds_Changed" Unchecked="ToggleSounds_Changed" />
                                    </Grid>
                                </Border>

                                <!-- Intelligent Dictation Cleanup -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="REESCRITURA INTELIGENTE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                        <TextBlock Text="Flow reconstruye el habla informal como texto natural, corrige expresiones y respeta el estilo elegido. Estas opciones controlan cuánto interviene antes de pegarlo." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox x:Name="ToggleRemoveFillers" Grid.Row="0" Grid.Column="0" Content="Quitar muletillas y pausas" AutomationProperties.Name="Quitar muletillas y pausas" IsChecked="True" Margin="0,0,0,10" Checked="CorrectionOption_Changed" Unchecked="CorrectionOption_Changed" />
                                            <CheckBox x:Name="ToggleRemoveRepetitions" Grid.Row="0" Grid.Column="2" Content="Quitar repeticiones" AutomationProperties.Name="Quitar repeticiones" IsChecked="True" Margin="0,0,0,10" Checked="CorrectionOption_Changed" Unchecked="CorrectionOption_Changed" />
                                            <CheckBox x:Name="ToggleResolveCorrections" Grid.Row="1" Grid.Column="0" Content="Resolver autocorrecciones" AutomationProperties.Name="Resolver autocorrecciones" IsChecked="True" Checked="CorrectionOption_Changed" Unchecked="CorrectionOption_Changed" />
                                            <CheckBox x:Name="ToggleFormatText" Grid.Row="1" Grid.Column="2" Content="Dar formato a párrafos y listas" AutomationProperties.Name="Dar formato a párrafos y listas" IsChecked="True" Checked="CorrectionOption_Changed" Unchecked="CorrectionOption_Changed" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Auto-Start with Windows -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Iniciar Automáticamente con Windows" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Ejecuta Flow en segundo plano al arrancar el equipo para tener siempre listo Ctrl + Win." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleAutoStart" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="ToggleAutoStart_Changed" Unchecked="ToggleAutoStart_Changed" />
                                    </Grid>
                                </Border>

                                <!-- Hotkey Info -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Atajo Global de Dictado" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Mantén pulsado para dictar; toca 2 veces para dejarlo activo y vuelve a tocar 2 veces para terminar y pegar." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                            <TextBlock Text="Ctrl + Win" Foreground="{DynamicResource BrushAccentPurple}" FontWeight="Bold" FontSize="12.5" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- FlowHub Homelab Connection -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="CONEXIÓN FLOWHUB (HOMELAB)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Servidor FlowHub URL" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                                <TextBox x:Name="ServerUrlInput" Text="http://127.0.0.1:8790" Style="{StaticResource WisprTextBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Token de Aplicación" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                                <TextBox x:Name="ServerTokenInput" Text="●●●●●●●●" Style="{StaticResource WisprTextBox}" />
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="Guardar y probar sincronización" Style="{StaticResource WisprGhostButton}" HorizontalAlignment="Left" Click="TestSyncBtn_Click" />
                                    </StackPanel>
                                </Border>

                                <!-- Database Path -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Base de Datos Local SQLite (WAL)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock x:Name="DbPathLabel" Text="C:\Users\pablo\AppData\Local\Flow\flow.db" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Abrir carpeta" Style="{StaticResource WisprGhostButton}" Click="OpenDbFolder_Click" />
                                    </Grid>
                                </Border>

                                <!-- Exit App Option -->
                                <Border Style="{StaticResource WisprCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Salir de Flow" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Cierra el proceso y detiene la escucha del atajo de teclado en segundo plano." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Cerrar completamente" Style="{StaticResource WisprGhostButton}" Foreground="{DynamicResource BrushTextSecondary}" Click="QuitApp_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
