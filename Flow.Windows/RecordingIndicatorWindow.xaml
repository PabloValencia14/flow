<Window x:Class="Flow.Windows.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Flow.Windows"
        Width="384" Height="184"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Grid>
        <Border x:Name="PillBorder"
                Width="344" MinHeight="52" Height="Auto"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom" Margin="0,0,0,18"
                Padding="12,9"
                CornerRadius="28"
                Background="{DynamicResource BrushIslandBg}"
                BorderBrush="{DynamicResource BrushIslandBorder}"
                BorderThickness="1"
                ClipToBounds="True"
                MouseDown="PillBorder_MouseDown"
                RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PillTranslate" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="PillShadow" BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.38" Color="#000000" />
            </Border.Effect>

            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelBtn" Grid.Row="0" Grid.Column="0" Width="26" Height="26"
                        Cursor="Hand" Click="CancelBtn_Click" ToolTip="Cancelar dictado (Esc)"
                        AutomationProperties.Name="Cancelar dictado">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.72" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.72" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Rectangle x:Name="PulseRing" Width="14" Height="14" Fill="{DynamicResource BrushIslandInk}" Opacity="0.32" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="PulseRingScale" ScaleX="1" ScaleY="1" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="PulseDot" Width="8" Height="8" Fill="{DynamicResource BrushIslandInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <local:VoiceSignal x:Name="WaveBarsContainer" Width="224" Height="30"
                                       ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="DurationLabel" Text="0:00" Foreground="{DynamicResource BrushIslandPending}" FontSize="11"
                               FontFamily="Consolas" VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer x:Name="TranscriptPreviewScroll" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                              Visibility="Collapsed" MaxHeight="82" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="8,7,8,0"
                              Background="Transparent" BorderThickness="0">
                    <TextBlock x:Name="TranscriptPreviewText" Text="" Foreground="{DynamicResource BrushIslandText}"
                               FontSize="17" LineHeight="23" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TranscriptRise" Y="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </ScrollViewer>

                <Button x:Name="FinishBtn" Grid.Row="0" Grid.Column="2" Width="26" Height="26"
                        Cursor="Hand" Click="FinishBtn_Click" ToolTip="Terminar y pegar"
                        AutomationProperties.Name="Terminar y pegar">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent">
                                <TextBlock Text=">" FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushIslandInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.72" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.72" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
