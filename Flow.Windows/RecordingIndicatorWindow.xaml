<Window x:Class="Flow.Windows.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="80"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Grid>
        <!-- Dynamic Island Pill Container with generous margin to eliminate shadow clipping -->
        <Border x:Name="PillBorder"
                Width="260" Height="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="6,3"
                CornerRadius="22"
                Background="{DynamicResource BrushFlowPillBg}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1.2"
                MouseDown="PillBorder_MouseDown"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PillTranslate" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.38" Color="#000000" />
            </Border.Effect>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Left: Cancel Button -->
                    <ColumnDefinition Width="28" />
                    <!-- Center: Recorder Graph, Time & Status -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Finish Button -->
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <!-- Left: Cancel Button (✕) -->
                <Button x:Name="CancelBtn" Grid.Column="0" Width="26" Height="26" Cursor="Hand" Click="CancelBtn_Click" ToolTip="Cancelar dictado (Esc)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="13">
                                <Path Width="8.5" Height="8.5" Stretch="Uniform" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="{StaticResource IconClose}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Center: Audio Recorder Visualizer Graph -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Glowing Pulse Dot -->
                    <Grid Width="12" Height="12" Margin="0,0,6,0">
                        <Ellipse x:Name="PulseRing" Width="12" Height="12" Fill="{DynamicResource BrushAccentRecording}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="PulseRingScale" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="PulseDot" Width="6.5" Height="6.5" Fill="{DynamicResource BrushAccentRecording}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Recording Time Counter / Status -->
                    <TextBlock x:Name="DurationLabel" Text="0:00" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe UI" />

                    <!-- Dynamic Dictaphone Recorder Waveform (7 Live Bars) -->
                    <StackPanel x:Name="WaveBarsContainer" Orientation="Horizontal" VerticalAlignment="Center" Height="22">
                        <Rectangle Width="3" Height="8" Margin="1.2,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource BrushTextMuted}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar1Scale" ScaleY="0.25" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="13" Margin="1.2,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource BrushTextSecondary}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar2Scale" ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="18" Margin="1.2,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource BrushAccentPurpleDark}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar3Scale" ScaleY="0.4" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="22" Margin="1.2,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource BrushAccentPurple}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar4Scale" ScaleY="0.5" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="18" Margin="1.2,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource BrushAccentPurpleDark}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar5Scale" ScaleY="0.4" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="13" Margin="1.2,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource BrushTextSecondary}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar6Scale" ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="8" Margin="1.2,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource BrushTextMuted}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar7Scale" ScaleY="0.25" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Finish Button (✓) -->
                <Button x:Name="FinishBtn" Grid.Column="2" Width="26" Height="26" Cursor="Hand" Click="FinishBtn_Click" ToolTip="Terminar y pegar">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{DynamicResource BrushWisprGradient}" CornerRadius="13">
                                <Path Width="10.5" Height="10.5" Stretch="Uniform" Stroke="{DynamicResource BrushOnAccent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="{StaticResource IconCheck}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
