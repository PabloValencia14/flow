<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Flow Monochrome Palette: black, white and neutral grays only. -->
    <Color x:Key="ColorBgMain">#0B0B0B</Color>
    <Color x:Key="ColorBgSidebar">#111111</Color>
    <Color x:Key="ColorBgCard">#181818</Color>
    <Color x:Key="ColorBgCardHover">#242424</Color>
    <Color x:Key="ColorBgInput">#121212</Color>
    <Color x:Key="ColorBorder">#2B2B2B</Color>
    <Color x:Key="ColorBorderHover">#484848</Color>
    <Color x:Key="ColorTextPrimary">#F5F5F5</Color>
    <Color x:Key="ColorTextSecondary">#B5B5B5</Color>
    <Color x:Key="ColorTextMuted">#7A7A7A</Color>
    <Color x:Key="ColorAccentPurple">#F5F5F5</Color>
    <Color x:Key="ColorAccentPurpleDark">#D6D6D6</Color>
    <Color x:Key="ColorAccentIndigo">#F5F5F5</Color>
    <Color x:Key="ColorAccentRecording">#F5F5F5</Color>
    <Color x:Key="ColorAccentSuccess">#F5F5F5</Color>
    <Color x:Key="ColorAccentWarning">#D6D6D6</Color>

    <!-- Solid Brushes (Overridden dynamically by ThemeManager) -->
    <SolidColorBrush x:Key="BrushBgMain" Color="#0B0B0B" />
    <SolidColorBrush x:Key="BrushBgSidebar" Color="#111111" />
    <SolidColorBrush x:Key="BrushBgCard" Color="#181818" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="#242424" />
    <SolidColorBrush x:Key="BrushBgInput" Color="#121212" />
    <SolidColorBrush x:Key="BrushBorder" Color="#2B2B2B" />
    <SolidColorBrush x:Key="BrushBorderHover" Color="#484848" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F5F5F5" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#B5B5B5" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#7A7A7A" />
    <SolidColorBrush x:Key="BrushAccentPurple" Color="#F5F5F5" />
    <SolidColorBrush x:Key="BrushAccentPurpleDark" Color="#D6D6D6" />
    <SolidColorBrush x:Key="BrushAccentRecording" Color="#F5F5F5" />
    <SolidColorBrush x:Key="BrushAccentSuccess" Color="#F5F5F5" />
    <SolidColorBrush x:Key="BrushAccentWarning" Color="#D6D6D6" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="#0B0B0B" />

    <!-- Kept as resource keys for compatibility; both are intentionally solid. -->
    <SolidColorBrush x:Key="BrushWisprGradient" Color="#F5F5F5" />
    <SolidColorBrush x:Key="BrushFlowPillBg" Color="#151515" />

