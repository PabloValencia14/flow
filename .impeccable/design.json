      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-item\" aria-current=\"page\"><span class=\"ds-nav-index\">01</span> Dictados</button></nav>",
      "css": ".ds-nav{background:#1B2720;padding:14px}.ds-nav-item{font-family:'Segoe UI',sans-serif;border-radius:0;cursor:pointer;position:relative;background:transparent;color:#C1CABB;border:0;padding:8px 10px;margin:1.5px 0;font-size:13px;font-weight:500;}.ds-nav-index{font:10px Consolas,monospace;margin-right:6px}.ds-nav-item:hover{background:#2B3B30;color:#F1F4E8}.ds-nav-item:focus-visible{outline: auto;outline-offset:2px;}.ds-nav-item:active{background:#2B3B30}.ds-nav-item[aria-current]{background:#B9E957;color:#18210F;font-weight:600}.ds-nav-item[aria-current]::before{content:'';display:inline-block;width:3px;height:18px;vertical-align:middle;background:#18210F;margin-right:6px}"
